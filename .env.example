# llama-server (llama.cpp) — OpenAI-compatible API
# Generation server (chat completions)
# Local CLI: http://localhost:8081
# Docker scraper accessing a llama-server on the Mac host: http://host.docker.internal:8081
OLLAMA_HOST=http://localhost:8081
OLLAMA_MODEL=qwen

# Embedding server (may run on a separate port/process)
# Leave blank to share the generation server host above.
OLLAMA_EMBED_HOST=http://localhost:8080
OLLAMA_EMBED_MODEL=nomic-embed-text

# Read inactivity timeout (seconds); generation streams tokens with thinking disabled
OLLAMA_TIMEOUT=600
# Max characters of page text sent to Ollama per step (avoids long timeouts on large pages)
MAX_LLM_INPUT_CHARS=10000
# Caps per-chunk embedding input to fit the embed model context window (nomic-embed-text ~2048 tokens)
MAX_EMBED_INPUT_CHARS=6000
# Cap tokens generated per Ollama call
OLLAMA_NUM_PREDICT=4096

# ChromaDB vector memory
CHROMA_HOST=localhost
CHROMA_PORT=8000

# Agent behavior
SIMILARITY_THRESHOLD=0.85

# Docker entrypoint: set true to poll Ollama/Chroma before scrape (default: false)
WAIT_FOR_SERVICES=false

# Docker scraper-agent output directory
SCRAPED_DATA_DIR=./scraped_data
